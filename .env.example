# Set this in your shell before starting the app. Never put your key in browser code.
GEMINI_API_KEY=your_gemini_api_key
# Set AI_PROVIDER to "groq" to use GROQ_API_KEY instead.
AI_PROVIDER=gemini
GROQ_API_KEY=your_groq_api_key
# Optional: override the Gemini or Groq model.
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b
# Optional: override the local port.
PORT=3000
